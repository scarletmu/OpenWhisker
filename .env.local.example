# Copy this file to .env.local. The real .env.local is ignored by git.

# OpenAI-compatible Raw Organizer
OPENWHISKER_RAW_ORGANIZER=deterministic
OPENWHISKER_CONTEXT_MODE=minimal
# generic is portable. Use knowledge-vault for /Users/wang/Documents/KnowLedge.
# Future profiles should be generated by vault-local skills, reviewed, then configured here.
OPENWHISKER_VAULT_PROFILE=generic
# Optional overrides for a custom vault pattern.
OPENWHISKER_RAW_INBOX_DIR=
OPENWHISKER_RAW_PROCESSED_DIR=
OPENWHISKER_KNOWLEDGE_DIR=
OPENWHISKER_KNOWLEDGE_DRAFT_DIR=
OPENWHISKER_REQUIRED_DRAFT_TAGS=
OPENWHISKER_LLM_API_KEY=
OPENWHISKER_LLM_MODEL=
OPENWHISKER_LLM_BASE_URL=

# Matrix Adapter
OPENWHISKER_MATRIX_HOMESERVER=
# Prefer password login locally; OpenWhisker caches the resulting Matrix session under data/.
OPENWHISKER_MATRIX_PASSWORD=
OPENWHISKER_MATRIX_ACCESS_TOKEN=
OPENWHISKER_MATRIX_SESSION_FILE=data/matrix-session.json
OPENWHISKER_MATRIX_USER_ID=
OPENWHISKER_MATRIX_ROOM_ID=

# Optional local paths
OPENWHISKER_DEBUG_DB=data/openwhisker-debug.db
OPENWHISKER_DEBUG_VAULT=testdata/vault
OPENWHISKER_OB_BIN=ob
